# Timestamp generated by the MIOS runtime. The controller measures freshness
# at receipt with its own clock; this stamp remains useful for diagnostics.
builtin_interfaces/Time stamp

# The transport deliberately describes a high-level MIOS actuator snapshot,
# rather than a final hardware effort command. Additional MIOS modes can be
# added without changing the ROS-control ownership boundary.
uint8 MODE_STOP=0
uint8 MODE_JOINT_IMPEDANCE=1
uint8 MODE_CARTESIAN_IMPEDANCE=2
uint8 MODE_JOINT_VELOCITY=3
uint8 MODE_CARTESIAN_VELOCITY=4
uint8 MODE_JOINT_POSITION=5
uint8 MODE_CARTESIAN_POSE=6
uint8 MODE_CARTESIAN_FORCE=7
uint8 MODE_NULLSPACE=8
uint8 mode

# Joint-impedance fields for MODE_JOINT_IMPEDANCE. Position is in radians,
# velocity in rad/s, feed-forward torque in Nm, stiffness in Nm/rad, and
# damping in Nm/(rad/s). Fixed-size arrays prevent partial-arm commands.
float64[7] joint_position
float64[7] joint_velocity
float64[7] joint_torque_feedforward
float64[7] joint_stiffness
float64[7] joint_damping

# MODE_JOINT_VELOCITY uses joint_velocity only. The value is consumed by the
# separate MIOS joint-velocity controller, which claims velocity interfaces
# rather than effort interfaces.

# MODE_JOINT_POSITION uses joint_position only. The separate position
# controller captures current position at activation and holds it for stale or
# stop input; it never treats an all-zero message as a safe position target.

# MODE_CARTESIAN_POSE uses target_base_to_end_effector only. The separate
# controller captures the live end-effector pose at activation and holds the
# live pose for stale or stop input; it never treats a default matrix as safe.

# MODE_CARTESIAN_FORCE uses target_external_wrench only. It is a base-frame
# desired external wrench, using the same [force xyz, torque xyz] order as
# Franka's O_F_ext_hat_K measurement.
float64[6] target_external_wrench

# MODE_NULLSPACE uses joint_position, joint_stiffness, and joint_damping only.
# It projects the resulting joint impedance torque into the damped Cartesian
# Jacobian null space before writing effort interfaces.

# Base-frame Cartesian impedance fields for MODE_CARTESIAN_IMPEDANCE. The
# target pose is a column-major homogeneous base-to-end-effector transform;
# target velocity and wrench use [linear xyz, angular xyz]. Stiffness has
# [N/m, Nm/rad] units and damping has [N/(m/s), Nm/(rad/s)] units. The
# controller uses the Franka zero Jacobian to map the resulting wrench to the
# seven joint effort interfaces. MODE_CARTESIAN_VELOCITY uses only
# target_cartesian_velocity in the separate Cartesian-velocity controller.
float64[16] target_base_to_end_effector
float64[6] target_cartesian_velocity
float64[6] cartesian_wrench_feedforward
float64[6] cartesian_stiffness
float64[6] cartesian_damping

# Mirrors the Coriolis term present in the legacy Cartesian-joint torque
# pipeline. It is ignored by MODE_JOINT_IMPEDANCE.
bool use_coriolis_compensation

# A true value is fail-safe: the controller clears torque in the same update
# cycle. It is distinct from a completed skill, which sends a final finite
# impedance target and then stops publishing.
bool user_stopped
