# Timestamp generated by the MIOS runtime. The controller validates freshness
# using its own ROS clock when it receives this command.
builtin_interfaces/Time stamp

# Joint torques in Nm, without gravity compensation. The fixed-size array
# deliberately prevents partial arm commands at the controller boundary.
float64[7] effort

# Snapshot of Franka's user-stop state at command generation. A true value is
# fail-safe: the effort controller clears its command immediately.
bool user_stopped
