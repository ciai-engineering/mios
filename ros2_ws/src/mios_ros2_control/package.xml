<?xml version="1.0"?>
<package format="3">
  <name>mios_ros2_control</name>
  <version>0.1.0</version>
  <description>ROS 2 control controllers for MIOS effort/impedance, joint-position, joint-velocity, Cartesian-velocity, and Cartesian-pose pipelines.</description>
  <maintainer email="maintainers@example.invalid">MIOS maintainers</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>controller_interface</build_depend>
  <build_depend>franka_msgs</build_depend>
  <build_depend>franka_semantic_components</build_depend>
  <build_depend>mios_msgs</build_depend>
  <build_depend>realtime_tools</build_depend>
  <build_depend>rclcpp</build_depend>
  <build_depend>std_msgs</build_depend>

  <exec_depend>pluginlib</exec_depend>
  <exec_depend>controller_interface</exec_depend>
  <exec_depend>franka_msgs</exec_depend>
  <exec_depend>franka_semantic_components</exec_depend>
  <exec_depend>mios_msgs</exec_depend>
  <exec_depend>realtime_tools</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>ament_index_python</test_depend>
  <test_depend>controller_manager</test_depend>
  <test_depend>controller_manager_msgs</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>rcl_interfaces</test_depend>
  <test_depend>robot_state_publisher</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
