+void Robot::writeOnceJointPositionEffort(const std::vector<double>& position_command,
+                                         const std::vector<double>& effort_command) {
+  if (!active_control_) {
+    throw std::runtime_error("Control hasn't been started");
+  }
+  if (position_command.size() != kMaxNumberOfJoints ||
+      effort_command.size() != kMaxNumberOfJoints || !joint_position_interface_active_ ||
+      !effort_interface_active_) {
+    throw std::invalid_argument("Combined joint position/effort command is invalid.");
+  }
+  std::array<double, kMaxNumberOfJoints> positions{};
+  std::array<double, kMaxNumberOfJoints> efforts{};
+  std::copy(position_command.begin(), position_command.end(), positions.begin());
+  std::copy(effort_command.begin(), effort_command.end(), efforts.begin());
+  writeOnceJointPositionsWithEfforts(positions, efforts);
+}
